<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
	<Product Id="*" Name="SampleApp Setup" Language="1033" Version="1.0.0.0" Manufacturer="SwinburneStudent"
	UpgradeCode="7A4BB8F8-837A-41F2-B379-F9AFDE339CB9">
		<Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
		<MediaTemplate EmbedCab="yes" />
		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="ProgramFilesFolder">
				<Directory Id="INSTALLFOLDER" Name="SampleApp" />
			</Directory>
		</Directory>
		<DirectoryRef Id="INSTALLFOLDER">
			<Component Id="MainExecutable" Guid="882392B1-9892-4C0A-98E5-7F97699946BE">

				<File
					Id="SampleAppEXE"
					Source="$(var.SampleApp.TargetDir)SampleApp.exe"
					KeyPath="yes" />

				<File
					Id="SampleAppDLL"
					Source="$(var.SampleApp.TargetDir)SampleApp.dll" />

				<File
					Id="SampleAppRuntimeConfig"
					Source="$(var.SampleApp.TargetDir)SampleApp.runtimeconfig.json" />

				<File
					Id="SampleAppDeps"
					Source="$(var.SampleApp.TargetDir)SampleApp.deps.json" />

			</Component>
		</DirectoryRef>
		<Feature Id="ProductFeature" Title="SampleAppSetup" Level="1">
			<ComponentRef Id="MainExecutable" />
		</Feature>
	</Product>
</Wix>